# Copy to backend.hcl (git-ignored). Replace 123456789012 with the AWS account ID
# (aws sts get-caller-identity --query Account --output text).
bucket       = "facaibank-tfstate-123456789012"
key          = "facaibank/dev/terraform.tfstate"
region       = "ap-southeast-1"
use_lockfile = true
encrypt      = true
