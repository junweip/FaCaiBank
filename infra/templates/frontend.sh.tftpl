#!/bin/bash
# Bootstraps the frontend web tier: nginx serves the page shell and proxies /api
# to the internal ALB. CloudFront serves /assets/* straight from S3.
set -euo pipefail
exec > >(tee /var/log/facaibank-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

dnf install -y nginx unzip amazon-cloudwatch-agent
aws s3 cp "s3://${bucket_name}/${bundle_key}" /tmp/frontend.zip --region "${aws_region}"
rm -rf /usr/share/nginx/html/*
unzip -q -o /tmp/frontend.zip -d /usr/share/nginx/html
cat > /usr/share/nginx/html/assets/config.js <<'CONFIG'
${frontend_config}
CONFIG

cat > /etc/nginx/conf.d/facaibank.conf <<'NGINX'
server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 11m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The internal ALB's node addresses change over time. A literal hostname in
    # proxy_pass is resolved once at startup, so nginx would keep sending requests
    # to nodes that no longer exist. A variable makes nginx resolve it at request time.
    location /api/ {
        resolver 169.254.169.253 valid=10s ipv6=off;
        set $internal_alb "${internal_alb_dns}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$internal_alb;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=300";
    }

    location / {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff";
        add_header X-Frame-Options "DENY";
        try_files $uri $uri/ /index.html;
    }
}
NGINX
rm -f /etc/nginx/conf.d/ssl.conf

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/nginx/access.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}-access"},
          {"file_path": "/var/log/nginx/error.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}-error"},
          {"file_path": "/var/log/facaibank-bootstrap.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}-bootstrap"}
        ]
      }
    }
  }
}
CWAGENT
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

systemctl enable --now nginx
