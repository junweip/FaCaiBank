#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/facaibank-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

dnf install -y python3.12 python3.12-pip unzip
mkdir -p /opt/facaibank/backend
aws s3 cp "s3://${bucket_name}/${bundle_key}" /tmp/backend.zip --region "${aws_region}"
unzip -q -o /tmp/backend.zip -d /opt/facaibank/backend
python3.12 -m venv /opt/facaibank/backend/venv
/opt/facaibank/backend/venv/bin/pip install --no-cache-dir -r /opt/facaibank/backend/requirements.txt

cat > /etc/facaibank-backend.env <<'ENV'
AWS_REGION=${aws_region}
DATABASE_HOST=${database_host}
DATABASE_NAME=${database_name}
DATABASE_SECRET_ARN=${database_secret_arn}
LEDGER_TABLE_NAME=${ledger_table_name}
KYC_STATEMENTS_BUCKET=${bucket_name}
STATEMENT_QUEUE_URL=${statement_queue_url}
CORS_ORIGINS=
ENV
chmod 600 /etc/facaibank-backend.env

cat > /etc/systemd/system/facaibank-backend.service <<'UNIT'
[Unit]
Description=FaCaiBank FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/facaibank/backend
EnvironmentFile=/etc/facaibank-backend.env
ExecStart=/opt/facaibank/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now facaibank-backend.service
